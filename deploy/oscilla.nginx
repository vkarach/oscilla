server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /home/valik/projects/oscilla;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Every deploy replaces index.html, while hashed assets never change.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
